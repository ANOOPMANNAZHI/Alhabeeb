	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS16122020"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="132"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="861"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="as_on_date" class="java.util.Date" isForPrompting="false"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct  b.building_name,b.building_code,u.unit_no,x.contract_start_date,x.contract_end_date,
tn.tenant_name,	y.list_items				
from units u
left join buildings b on u.building_id=b.id
left join tenant_contracts tc on u.id=tc.unit_id
left join tenant tn on tn.id=tc.tenant_id
left join landlord_contract lc on b.id=lc.building_id
left join (select  u.unit_code, string_agg(CONCAT(hu.home_utilities_code,'-', uu.utiltity_count), ',') as list_items
  					from units u
		   			 left join buildings b on b.id = u.building_id
  					 left join unit_utilities uu on uu.unit_id = u.id
		   			  left join home_utilities hu on hu.id = uu.home_utility_id
					  where u.unit_is_furnished='1' and uu.utiltity_count >='1'
 					group by u.unit_code) as y	
           on y.unit_code=u.unit_code
left join (select  u.unit_code,max(tc.tenant_contract_start_date)as contract_start_date,max(tc.tenant_contract_valid_to_date) as contract_end_date
  					from units u
		   			 left join buildings b on u.building_id=b.id
                    left join tenant_contracts tc on u.id=tc.unit_id
 					group by u.unit_code order by u.unit_code) as x
           on u.unit_code=x.unit_code           
where u.unit_is_furnished='1' and u.unit_status = '1' 
and b.building_name = $P{building_name}
and y.list_items is not null
]]>
	</queryString>
