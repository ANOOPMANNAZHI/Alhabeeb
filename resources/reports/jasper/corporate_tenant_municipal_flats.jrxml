<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="landlordcontract_report" language="javascript" pageWidth="1205" pageHeight="1000" orientation="Landscape" columnWidth="1165" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e1d93b-2fdc-48d5-bc52-1e8512fe354d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="663"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="323"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS14102020"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="tenant_name" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct tc.id,tn.tenant_name,tn.tenant_code,bl.building_name,bl.building_no,un.unit_no,ut.unit_types_name,
tc.tenant_contract_start_date as ContractFrom,tc.tenant_contract_valid_to_date as ContractTo,
pm.payment_method_code,tc.tenant_contract_muncipality_agr_no,
a.renteffectiveto,
case when c.receiptgeneration_amt is null 
then 
f.months * tc.tenant_contract_rent
else
(f.months * tc.tenant_contract_rent)- c.receiptgeneration_amt end as rentdues,c.receiptgeneration_amt,
oc.occupant_name,
case when pdc_check = 1 then 'Yes' else 'No' end as pdc_yn,
 tc.tenant_contract_rent as rentpm
from tenant tn 
left join tenant_contracts tc on tn.id=tc.tenant_id
left join buildings bl on bl.id=tc.building_id
left join units un on un.id=tc.unit_id
left join unit_types ut on ut.id=un.unit_type_id
left join tenant_types tt on tt.id = tn.tenant_type_id
left join payment_method pm on pm.payment_method_index=tc.tenant_contract_payment_type
left join occupants oc on oc.id=tc.occupant_id
left join receipts_generation rg on rg.tenant_contract_id=tc.id
left join (SELECT tenant_contract_no,sum(rg.receipts_generation_amt) as receiptgeneration_amt
                from tenant_contracts tc 
                left join receipts_generation rg on rg.tenant_contract_id=tc.id 
                group by tenant_contract_no)c on c.tenant_contract_no=tc.tenant_contract_no
left join (SELECT tenant_contract_no,max(rg.receipts_generation_eff_to) as renteffectiveto
                  from tenant_contracts tc 
                  left join receipts_generation rg on rg.tenant_contract_id=tc.id 
                  group by tenant_contract_no)a on a.tenant_contract_no=tc.tenant_contract_no
left join (select tenant_contract_no,	
                case when (SELECT EXTRACT(MONTH FROM tenant_contract_valid_to_date)) = (SELECT EXTRACT(MONTH FROM tenant_contract_start_date)) 
                then
                (SELECT (DATE_PART('year', tenant_contract_valid_to_date::date) - DATE_PART('year', tenant_contract_effective_date::date)) * 12 +
                               (DATE_PART('month', tenant_contract_valid_to_date::date) - DATE_PART('month', tenant_contract_effective_date::date))) 
                else 
               (SELECT (DATE_PART('year', tenant_contract_valid_to_date::date) - DATE_PART('year', tenant_contract_effective_date::date)) * 12 +
                               (DATE_PART('month', tenant_contract_valid_to_date::date) - DATE_PART('month', tenant_contract_effective_date::date)))+1
               end as months
from tenant_contracts) f on f.tenant_contract_no = tc.tenant_contract_no
where tt.tenant_types_name = 'Company' and tc.tenant_contract_status = '1' and (tn.tenant_code = $P{tenant_code} or tn.tenant_name = $P{tenant_name})
order by bl.building_name, un.unit_no desc]]>
	</queryString>
