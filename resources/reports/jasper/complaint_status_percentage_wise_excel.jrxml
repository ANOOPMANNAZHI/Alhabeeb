	<parameter name="username" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select a.ticketstatus,a.count,b.totticketcount,ROUND((a.count*100.0/b.totticketcount),2)as Percentage from
(select 
case
when ce.complaint_status=0 then 'Open'
when ce.complaint_status=1 then 'Partialy Closed'
when ce.complaint_status=2 then 'Closed'
end as ticketstatus,
count(ce.complaint_status) as count 
 from  complaint_enquiries ce where ce.complaint_date  between $P{Date1} and  $P{Date2}
group by ce.complaint_status order by ce.complaint_status desc
)a,
(Select count(ce.id) as totticketcount from complaint_enquiries ce where ce.complaint_date  between $P{Date1} and  $P{Date2}
)b]]>
	</queryString>
	<field name="ticketstatus" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="ticketstatus"/>
	</field>
	<field name="count" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="count"/>
	</field>
	<field name="totticketcount" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="totticketcount"/>
	</field>
	<field name="percentage" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="percentage"/>
	</field>
	<variable name="percentage_SUM" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{percentage}]]></variableExpression>
	</variable>
