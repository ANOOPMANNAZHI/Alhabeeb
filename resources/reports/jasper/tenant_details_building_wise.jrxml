<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="landlordcontract_report" language="javascript" pageWidth="1402" pageHeight="720" orientation="Landscape" columnWidth="1362" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e1d93b-2fdc-48d5-bc52-1e8512fe354d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="120"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="873"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="750"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="235"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS14102020"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="building_code" class="java.lang.String"/>
	<parameter name="employee_name" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct bl.building_name,tn.tenant_code,un.unit_no,tn.tenant_name,tn.tenant_employer_name,tn.tenant_personal_email,
na.nationality,
tn.tenant_post_box,tn.gsm_no,tn.resident_id,tn.tenant_resident_exp_date,tn.tenant_pc,tn.tenant_fax_no,
tn.tenant_contact_person,tn.tenant_residence_tel,tn.tenant_date_of_birth
from units un
left join buildings bl on un.building_id=bl.id
left join tenant_contracts tc on tc.unit_id=un.id
left join tenant tn on tn.id = tc.tenant_id
left join nationalities na on tn.nationalities_id=na.nationalityid
left join preferred_buildings pb on bl.id=pb.building_id
left join are_buildings are on are.id=pb.are_building_id
left join users us on us.id=are.user_id
left join employees emp on emp.id=us.user_type_id
where (tn.tenant_status = '1' and tc.tenant_contract_status = '1')and
(bl.building_name = $P{building_name} or bl.building_code = $P{building_code} or emp.employee_name = $P{employee_name}) 
order by un.unit_no desc]]>
	</queryString>
