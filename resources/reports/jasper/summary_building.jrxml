	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/"]]></defaultValueExpression>
	</parameter>
	<parameter name="building_code" class="java.lang.String"/>
	<parameter name="management_types_name" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT ut.unit_types_name as unit_type, 
       COUNT (case when ut.id= 1 then u.id
        when ut.id= 2 then u.id
        when ut.id= 3 then u.id 
        when ut.id= 4 then u.id
        when ut.id= 5 then u.id 
        when ut.id= 6 then u.id 
        when ut.id= 7 then u.id 
        when ut.id= 8 then u.id 
        when ut.id= 9 then u.id
	    when ut.id= 10 then u.id
        when ut.id= 11 then u.id
        when ut.id= 12 then u.id
        when ut.id= 13 then u.id
        when ut.id= 14 then u.id
        when ut.id= 15 then u.id
        when ut.id= 16 then u.id
        when ut.id= 17 then u.id
        when ut.id= 18 then u.id
        when ut.id= 19 then u.id
        when ut.id= 20 then u.id
        when ut.id= 22 then u.id
	when ut.id= 23 then u.id
	when ut.id= 24 then u.id
	when ut.id= 25 then u.id
	when ut.id= 26 then u.id
         end) as unitcount
FROM units u 
left join unit_types ut on ut.id = u.unit_type_id
 join buildings b on b.id = u.building_id
 join management_types mt on mt.id=b.management_id
where (u.unit_status = 1) and (b.building_status = 1)
and ((b.building_code =$P{building_code})
or (b.building_name = $P{building_name})
or (mt.management_types_name=$P{management_types_name} ))
GROUP BY ut.unit_types_name]]>
	</queryString>
	<field name="unit_type" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="unit_type"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="unit_types"/>
	</field>
	<field name="unitcount" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="unitcount"/>
	</field>
	<variable name="unitcount1" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{unitcount}]]></variableExpression>
	</variable>
	<variable name="unitcount2" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{unitcount}]]></variableExpression>
	</variable>
	<group name="unit_type">
		<groupExpression><![CDATA[$F{unit_type}]]></groupExpression>
	</group>
	<group name="unitcount">
