	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct b.building_code,b.building_name,b.building_no,b.building_pc,
b.plot_no,v.vendor_name,l.locations_name,mt.management_types_name,
v.vendor_contact_no,v.vendor_contact_email
from buildings b
join tenant_contracts tc on b.id = tc.building_id
left join landlord_contract lc on b.id=lc.building_id
left join vendors v on v.id=lc.vendor_id
left join locations l on l.id=b.location_id
left join management_types mt on mt.id=b.management_id
where (lc.landlord_contract_status='1' ) and 
(b.building_status='1') and (tc.tenant_contract_status='1') and
(v.vendor_name=$P{vendor_name}  and l.locations_name=$P{locations_name}) or
(v.vendor_name=$P{vendor_name}  and mt.management_types_name=$P{management_types_name}) or
(l.locations_name=$P{locations_name} and mt.management_types_name=$P{management_types_name})
order by b.building_code]]>
	</queryString>
