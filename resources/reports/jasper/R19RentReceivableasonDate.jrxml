	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="building_no" class="java.lang.String"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="management_types_name" class="java.lang.String"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct n.netamtdue,t.tenant_name,tc.tenant_contract_no,tc.tenant_contract_old_no,u.unit_code,
tc.tenant_contract_start_date,tc.tenant_contract_valid_to_date,
case when rg.receipts_generation_payment_method = 1 then 'Cheque' else 'Cash' end as payment_mode,tc.tenant_contract_last_paid_date,tc.tenant_contract_rent,
tc.tenant_contract_value,
(date_trunc('MONTH', (tenant_contract_start_date + INTERVAL  '1month'*(c.receiptgeneration_amt/tc.tenant_contract_rent))::date) + INTERVAL '1 MONTH - 1 day')::DATE as lastpaiddate,
t.tenant_contact_no,
case when tc.pdc_check = 1 then 'Full'
     when tc.pdc_check = 2 then 'Partial' 
end as PDC,
a.nopdc_clsd,t.tenant_contact_person,y.collected_amt,
case when y.collected_amt <> null then
(((SELECT (DATE_PART('year', $P{Date2}::date) - DATE_PART('year', $P{Date1}::date)) * 12 +
              (DATE_PART('month', $P{Date2}::date) - DATE_PART('month', $P{Date1}::date)))*tc.tenant_contract_rent)-y.collected_amt) else
(((SELECT (DATE_PART('year', $P{Date2}::date) - DATE_PART('year', $P{Date1}::date)) * 12 +
              (DATE_PART('month', $P{Date2}::date) - DATE_PART('month', $P{Date1}::date)))*tc.tenant_contract_rent)) end as totaldue
from tenant_contracts tc
left join tenant t on t.id = tc.tenant_id
left join units u on u.id = tc.unit_id
left join receipts_generation rg on rg.tenant_contract_id = tc.id
left join buildings b on b.id = tc.building_id
left join management_types mt on mt.id=b.management_id
left join (SELECT tc.id,sum(rg.receipts_generation_amt) as receiptgeneration_amt
	   from tenant_contracts tc
	   left join receipts_generation rg on rg.tenant_contract_id=tc.id group by tc.id)c on c.id=tc.id
left join (select tc.tenant_contract_no,count(rg.id) as nopdc_clsd
	   from receipts_generation rg 
	   left join tenant_contracts tc on rg.tenant_contract_id = tc.id
	   left join pdc p on p.tenant_contract_id = rg.tenant_contract_id
	   where p.pdc_cancel_reason = '1' and rg.receipts_generation_payment_method = '2'
	   group by tc.tenant_contract_no) a on a.tenant_contract_no = tc.tenant_contract_no
left join (select tc.id,sum(receipts_generation_amt) as collected_amt from receipts_generation rg
	left join tenant_contracts tc on tc.id = rg.tenant_contract_id
	left join buildings b on b.id = tc.building_id
	where rg.receipts_generation_receipt_date <= $P{Date2} group by tc.id) as y 
	on y.id=tc.id
left join (select tc.id,(tc.tenant_contract_rent/30)*(now()::date - tc.tenant_contract_start_date::date) as netamtdue 
    from tenant_contracts tc) as n on n.id = tc.id 
where b.building_no = $P{building_no} or  b.building_name = $P{building_name} or mt.management_types_name=$P{management_types_name}
or t.tenant_code=$P{tenant_code}
and (tc.tenant_contract_last_paid_date between $P{Date1} and $P{Date2})
order by tc.tenant_contract_no desc]]>
	</queryString>
