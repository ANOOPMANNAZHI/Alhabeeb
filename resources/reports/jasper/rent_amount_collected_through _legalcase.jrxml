	<parameter name="logo" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct l.id,a.receiptno as docno,a.receiptdate as Docdate,t.tenant_name as tenantname,u.unit_no as unitno,
b.building_name as building,a.receiptfrom as  fromdate,a.receiptto as todate,a.receiptdesc as desc,
a.receiptamt as amount,tc.tenant_contract_rent
from legal l
left join tenant_contracts tc on tc.id=l.tenant_contract_id
left join receipts_generation rg on rg.tenant_contract_id=tc.id
left join tenant t on t.id=tc.tenant_id
left join units u on u.id= tc.unit_id
left join buildings b on b.id=tc.building_id
left join (select tec.id, max(reg.receipts_generation_receipt_date) as receiptdate,
						  max(reg.receipts_generation_receipt_no) as receiptno,
		   				  max(reg.receipts_generation_eff_from) as receiptfrom,
		                  max(reg.receipts_generation_eff_to) as receiptto,
		                  max(reg.receipts_generation_description) as receiptdesc,
		                  sum(reg.receipts_generation_amt) as receiptamt
		   from receipts_generation reg 
		   left join tenant_contracts tec on tec.id = reg.tenant_contract_id
		   group by tec.id)a on a.id = tc.id
where 
(l.work_flow_processes_code='803') and (rg.receipts_generation_type='0')
and (a.receiptdate between $P{Date1} and $P{Date2})]]>
	</queryString>
