	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS_NEW"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="306"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="687"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="as_on_date" class="java.util.Date"/>
	<parameter name="building_code" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct  b.building_name,b.building_code,u.unit_no,u.unit_code,tc.tenant_contract_start_date,tc.tenant_contract_valid_to_date,
tn.tenant_name,y.list_items
from units u
left join buildings b on b.id=u.building_id
left join tenant_contracts tc on u.id=tc.unit_id
left join tenant tn on tn.id=tc.tenant_id
left join landlord_contract lc on b.id=lc.building_id
left join (select b.id as id,string_agg(amentity_types_name, ',') as list_items
  					from buildings b 
  					left join building_amentity ba on ba.landlord_building_id=b.id
  					left join amentity_types at on at.id=ba.amentity_type_id
 					group by b.id) as y	
 on 	y.id=b.id
where u.unit_is_furnished='1' and lc.landlord_contract_valid_from_date::date <= now()
order by b.building_name]]>
	</queryString>
