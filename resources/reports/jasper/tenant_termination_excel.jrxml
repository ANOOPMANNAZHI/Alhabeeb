<!-- Created with Jaspersoft Studio version 6.8.0.final using JasperReports Library version 6.8.0-2ed8dfabb690ff337a5797129f2cd92902b0c87b  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Early termination" language="javascript" pageWidth="1500" pageHeight="842" columnWidth="1460" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5a60b1dd-b84e-4a52-a4bd-105affc0f66a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="170"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="823"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select * from (select distinct tc.id as id,tc.tenant_contract_no,tc.tenant_contract_start_date::date as contract_from,
tc.tenant_contract_valid_to_date::date as contract_to,tc.tenant_contract_rent as rentpm,
tn.tenant_name as tenant_name,t.termination_date as  vaccated_on,u.unit_no as unit_no,
ut.unit_types_name as unit_type,b.building_name as bldg_name,b.building_no as bldg_no,
mt.management_types_name as mgmt_type,e.employee_name as are,y.collected_amt,
(date_trunc('MONTH', (tenant_contract_start_date + INTERVAL  '1month'*
					  (rg.receipts_generation_amt/tc.tenant_contract_rent))::date) 
 						+ INTERVAL '1 MONTH - 1 day')::DATE as last_paid_date,
(tc.tenant_contract_rent/30)*(now()::date - tc.tenant_contract_start_date::date) as rent_due,
case when tc.deposit_check = 1 then 'Yes' else 'No' end as deposit_check,
case 
when (ac.acc_code_val='41110') and (rgd.credit_amount = '0') then rgd.debit_amount
when (ac.acc_code_val='41110') and (rgd.debit_amount = '0') then rgd.credit_amount
end as maintenance_due,
case 
	when (ac.acc_code_val='41105') and (rgd.credit_amount = '0') then rgd.debit_amount
	when (ac.acc_code_val='41105') and (rgd.debit_amount = '0') then rgd.credit_amount
	end as EWCollected
from tenant_contracts tc
left join termination t on tc.id = t.contract_id
left join tenant tn on tn.id = tc.tenant_id
left join receipts_generation rg on rg.tenant_contract_id=tc.id
left join receipts_generation_dim rgd on rgd.receipts_generation_id=rg.id
left join acc_codes ac on ac.id=rgd.ac_codes_id
left join units u on u.id = tc.unit_id 
left join unit_types ut on ut.id = u.unit_type_id
left join buildings b on b.id = tc.building_id
left join management_types mt on mt.id=b.management_id
left join preferred_buildings pb on pb.building_id = b.id 
left join are_buildings ab on ab.id = pb.are_building_id 
left join users usr on usr.id = ab.user_id 
left join employees e on e.id = usr.user_type_id 
	left join (select tc.id,sum(receipts_generation_amt) as collected_amt from receipts_generation rg
	left join tenant_contracts tc on tc.id = rg.tenant_contract_id
	left join buildings b on b.id = tc.building_id group by tc.id) as y 
	on y.id=tc.id 
where pb.assign_to is null and t.termination_type_status='0' and t.termination_date between $P{Date1} and $P{Date2}
order by tc.tenant_contract_no
)x]]>
	</queryString>
