	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="building_name" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct tc.tenant_contract_no,b.management_id,tenant_invoice_date,tenant_invoice_no,tenant_invoice_desc,
t.tenant_code,t.tenant_name,x.terminationdate,tc.tenant_contract_effective_date,tc.tenant_contract_valid_to_date,u.unit_no,tenant_invoice_amt,
case when tenant_invoice_status = '3' then 'Yes' else 'No' end as Posted
from invoice inv
left join tenant_contracts tc on tc.id = inv.tenant_contract_id
left join tenant t on t.id = tc.tenant_id
left join (select tc.id, max(t.termination_date::date) as terminationdate from tenant_contracts tc 
		   left join termination t on t.contract_id = tc.id
		   group by tc.id) x on x.id = tc.id
left join buildings b on b.id = tc.building_id
left join units u on u.id = tc.unit_id
where (b.management_id = '1') and (inv.tenant_invoice_status!=2)
and (x.terminationdate>tenant_invoice_date or x.terminationdate is null)
and (tenant_invoice_date between $P{Date1} and $P{Date2})
order by u.unit_no]]>
	</queryString>
