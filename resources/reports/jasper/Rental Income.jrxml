	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="122"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="871"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS04012021"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<queryString>
		<![CDATA[select distinct b.management_id,tenant_invoice_date,tenant_invoice_no,tenant_invoice_desc,
t.tenant_code,t.tenant_name,tr.termination_date,b.unit_no,tenant_invoice_amt,
case when tenant_invoice_status = '3' then 'Yes' else 'No' end as Posted
from invoice inv
left join tenant_contracts tc on tc.id = inv.tenant_contract_id
left join tenant t on t.id = tc.tenant_id
left join termination tr on tr.contract_id = tc.id
 inner join view_blgd_details b on b.unit_id = tc.unit_id
where (b.management_id = '1') and (tenant_invoice_date between $P{Date1} and $P{Date2})
order by tenant_invoice_date]]>
	</queryString>
