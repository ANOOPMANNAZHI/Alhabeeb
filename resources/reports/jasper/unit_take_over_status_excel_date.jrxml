<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="landlordcontract_report" pageWidth="1620" pageHeight="2000" orientation="Landscape" columnWidth="1580" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e1d93b-2fdc-48d5-bc52-1e8512fe354d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="109"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="884"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="717"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="268"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS_NEW"/>
	<parameter name="logo" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<parameter name="Date3" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[select distinct t.tenant_contact_no as tenantcontactno,
b.building_name as building,u.unit_no as unitno,
t.tenant_name as tenant,ut.unit_types_name as unittype,em.employee_name as are,
tc.tenant_contract_valid_to_date as agrmtexp,tc.tenant_contract_deposit_amt as depositamt,
tr.termination_takenover_date::date as takeovrdate,tr.termination_date as terminationdate,
e.employee_name as assignto,
case
when (ac.acc_code_val='41110') and (rgd.credit_amount = '0') then rgd.debit_amount
when (ac.acc_code_val='41110') and (rgd.debit_amount = '0') then rgd.credit_amount
end as ManitananceDue,
case
when (ac.acc_code_val='41105') and (rgd.credit_amount = '0') then rgd.debit_amount
when (ac.acc_code_val='41105') and (rgd.debit_amount = '0') then rgd.credit_amount
end as EWCollected,
case when tr.work_flow_processes_code='503'then
tr.created_at::date end AS handoverdate,
(tc.tenant_contract_rent/30)*(now()::date - tc.tenant_contract_start_date::date) as TotalDues,
(date_trunc('MONTH', (tenant_contract_start_date + INTERVAL  '1month'*(c.receiptgeneration_amt/tc.tenant_contract_rent))::date) + INTERVAL '1 MONTH - 1 day')::DATE as lastpaiddate,
w.Other_due
 from termination tr
 left join tenant_contracts tc on tc.id=tr.contract_id
 left join tenant t on t.id=tc.tenant_id
 left join buildings b on b.id=tc.building_id
 left join units u on u.id=tc.unit_id
 left join unit_types ut on ut.id=u.unit_type_id
 left join termination_users tu on tu.termination_id=tr.id
 left join receipts_generation rg on rg.tenant_contract_id=tc.id
 left join receipts_generation_dim rgd on rgd.receipts_generation_id=rg.id
 left join acc_codes ac on ac.id=rgd.ac_codes_id
 left join users us on us.id=tr.assigned_to
 left join employees e on e.id=us.user_type_id
 left join (SELECT tenant_contract_no,sum(rg.receipts_generation_amt) as receiptgeneration_amt
 from tenant_contracts tc
 left join receipts_generation rg on rg.tenant_contract_id=tc.id group by tenant_contract_no)c on c.tenant_contract_no=tc.tenant_contract_no
 left join (select tc.id, sum(rgd.credit_amount) as Other_due    
from receipts_generation_dim rgd
left join receipts_generation rg on rg.id = rgd.receipts_generation_id
left join tenant_contracts tc on tc.id = rg.tenant_contract_id
left join acc_codes ac on ac.id=rgd.ac_codes_id
where ac.acc_code_val not in ('41105','41110')
group by tc.id) as w
on w.id=tc.id
left join (SELECT pb.building_id,employee_name from employees emp
  left join users us on emp.id = us.user_type_id
  left join are_buildings are on us.id=are.user_id
  left join preferred_buildings pb on are.id=pb.are_building_id
  where pb.assign_to is null)em on em.building_id = b.id
 where tr.work_flow_processes_code='504'
 and tc.tenant_contract_status='1'
 and tu.status='1'
 and (tr.termination_takenover_date::date between  $P{Date1} and $P{Date2})
order by  u.unit_no asc]]>
	</queryString>
