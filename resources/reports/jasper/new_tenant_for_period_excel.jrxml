	<parameter name="logo" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT distinct tc.tenant_contract_no,b.building_name,u.unit_no,ut.unit_types_name,tc.tenant_contract_muncipality_agr_no,
tn.tenant_name,emp.employee_name as Marketing_person,
tc.tenant_contract_effective_date::date,tc.tenant_contract_valid_to_date::date as contract_period_to,
tc.tenant_contract_rent as rentpm,
tenant_contract_registered_date::date as Registered_Date,
d.Nofpdc,
case when tc.deposit_check = 1 then 'Yes' else 'No' end as deposit_check
FROM tenant_contracts tc left join tenant tn on tn.id=tc.tenant_id
left join employees emp on emp.id=tc.tenant_marketing_executive
left join buildings b on b.id = tc.building_id
left join units u on u.id = tc.unit_id
left join unit_types ut on ut.id = u.unit_type_id
left join pdc p on tc.id=p.tenant_contract_id
left join (SELECT tenant_contract_id,count(p.tenant_contract_id) as Nofpdc from pdc p
	   group by tenant_contract_id)d on d.tenant_contract_id=p.tenant_contract_id
where (tc.tenant_contract_effective_date between $P{Date1} and $P{Date2}) and tc.tenant_contract_status = '1' and tc.tenant_contract_old_no is null
order by tenant_contract_effective_date]]>
	</queryString>
