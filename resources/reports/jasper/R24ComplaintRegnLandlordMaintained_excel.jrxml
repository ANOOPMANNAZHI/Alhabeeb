	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct ce.complaint_date,ce.complaint_no,b.building_name,
case when b.building_maintenance_info=0 then 'Managed by us' else 'Not Managed by us' end as maintainedby,
case when cc.assigned_to_type = 1 then 'Contractor' when cc.assigned_to_type = 0 then 'Supervisor' end as contractor,
case when cc.assigned_to_type = 1 then v.vendor_name end AS Supervisor,
u.unit_no,w.works_code as category,cc.checklist_desc as complaintdesc,em.employee_name as assignedto,e.employee_name as subassignedto,ce.complainer_name,
case when ce.complaint_status=2 then ce.updated_at end as closedon,ur.username,
case  when ce.complaint_status=2 then 'Closed'
     else 'Open' end as status
from complaint_enquiries ce 
join buildings b on b.id = ce.building_id
join complaint_checklists cc on cc.complaint_enquiries_id =ce.id
left join users us on us.id=cc.sub_assigned_to
left join employees e on e.id=us.user_type_id
left join users use  on use.id=cc.assigned_to
left join vendors v on v.id = cc.assigned_to
left join employees em on em.id=use.user_type_id
left join units u on u.id = ce.unit_id
right join works w on w.id = cc.work_id
left join users ur on ur.id=ce.created_by
left join tenant t  on t.id = ce.tenant_id
where (ce.complaint_date between $P{Date1} and $P{Date2})
and (b.building_maintenance_info=1)
order by ce.complaint_no desc]]>
	</queryString>
