<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="tenant_payment_history" pageWidth="1238" pageHeight="1200" orientation="Landscape" columnWidth="1198" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3a2eddc7-1a27-4d60-9553-a2cef208fbcb">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS_NEW"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="180"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="813"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="unit_id" class="java.lang.String"/>
	<parameter name="tenant_id" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select b.building_code,b.building_name,u.unit_no,t.tenant_name,t.tenant_code,tc.tenant_contract_no,tc.tenant_contract_start_date,
tc.tenant_contract_valid_to_date,tc.tenant_contract_rent,rg.receipts_generation_receipt_no,
rg.receipts_generation_receipt_date,rg.receipts_generation_amt,rg.receipts_generation_eff_from,
rg.receipts_generation_eff_to,bk.bank_name,rg.receipts_generation_cheque_no,
case rg.receipts_generation_payment_method
when 1 then 'Cheque'
else 'Cash'
end as receipts_generation_payment_method
from buildings b
left join units u on b.id=u.building_id
left join tenant_contracts tc on u.id=tc.unit_id
left join receipts_generation rg on tc.id=rg.tenant_contract_id 
left join tenant t on t.id=tc.tenant_id
left join bank bk on bk.id=rg.bank_id
where rg.receipts_generation_type='0' and u.unit_code = $P{unit_id} and t.tenant_name = $P{tenant_id}  and rg.receipts_generation_status ='3'
order by u.unit_no]]>
	</queryString>
