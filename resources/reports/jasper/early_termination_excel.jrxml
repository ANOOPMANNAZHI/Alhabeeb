<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Early termination" language="javascript" pageWidth="1500" pageHeight="842" columnWidth="1460" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5a60b1dd-b84e-4a52-a4bd-105affc0f66a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS16122020"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="170"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="823"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT distinct * from (
select distinct tc.id as contract, tc.tenant_contract_no as contract,mt.management_types_name,e.employee_name as are,b.building_name as buildingname,b.building_no as bldg_no,u.unit_no,
ut.unit_types_name,tn.tenant_name,tc.tenant_contract_start_date::date,tc.tenant_contract_valid_to_date::date,
tc.tenant_contract_rent as rentpm,z.termination_date as  vaccated_on,
a.renteff_to,f.months,
case 
when y.collected_amt is null then f.months * tc.tenant_contract_rent
else (f.months * tc.tenant_contract_rent)- y.collected_amt end as rent_due,
case when tc.deposit_check = 1 then 'Yes' else 'No' end as deposit_check,y.collected_amt as rent_amt,
m.maintenance_due,
s.EWCollected, 
w.Other_due,tr.termination_type_status as termination_status,tr.termination_type as terminationtype from tenant_contracts tc 
left join termination tr on tr.contract_id = tc.id
left join buildings b on b.id = tc.building_id
left join management_types mt on mt.id=b.management_id
left join preferred_buildings pb on pb.building_id = b.id
left join are_buildings ab on ab.id = pb.are_building_id
left join users usr on usr.id = ab.user_id
left join employees e on e.id = usr.user_type_id
left join units u on u.id = tc.unit_id
left join unit_types ut on ut.id = u.unit_type_id
left join tenant tn on tn.id = tc.tenant_id

left join (select tc.id,max(t.termination_date) as termination_date,max(tenant_contract_effective_date) from termination t
left join tenant_contracts tc on tc.id = t.contract_id
group by tc.id) as z
on z.id=tc.id

left join (select tc.id,sum(receipts_generation_amt) as collected_amt from receipts_generation rg
left join tenant_contracts tc on tc.id = rg.tenant_contract_id
left join buildings b on b.id = tc.building_id group by tc.id) as y
on y.id=tc.id

left join (select distinct ter.contract_id,
case when (SELECT EXTRACT(MONTH FROM max(termination_date))) = (SELECT EXTRACT(MONTH FROM max(tenant_contract_start_date)))
then
(SELECT (DATE_PART('year', max(termination_date)) - DATE_PART('year', max(tenant_contract_start_date))) * 12 +
              (DATE_PART('month', max(termination_date)) - DATE_PART('month', max(tenant_contract_start_date))))
else
(SELECT (DATE_PART('year', max(termination_date)) - DATE_PART('year', max(tenant_contract_start_date))) * 12 +
              (DATE_PART('month', max(termination_date)) - DATE_PART('month', max(tenant_contract_start_date))))+1
end as months
from termination ter
left join tenant_contracts tc on tc.id = ter.contract_id
		  group by ter.contract_id) f on f.contract_id = tc.id

left join (select tc.id, sum(rgd.credit_amount) as maintenance_due from receipts_generation_dim rgd
 join receipts_generation rg on rg.id = rgd.receipts_generation_id
 join tenant_contracts tc on tc.id = rg.tenant_contract_id
 join acc_codes ac on ac.id=rgd.ac_codes_id
where ac.acc_code_val =  '41110'
group by tc.id) as m on m.id=tc.id 

left join (select tc.id, sum(rgd.credit_amount) as EWCollected from receipts_generation_dim rgd
 join receipts_generation rg on rg.id = rgd.receipts_generation_id
 join tenant_contracts tc on tc.id = rg.tenant_contract_id
 join acc_codes ac on ac.id=rgd.ac_codes_id
where ac.acc_code_val = '41105'
group by tc.id) as s on s.id=tc.id

left join (SELECT tc.id,max(rg.receipts_generation_eff_to) as renteff_to
	   from tenant_contracts tc
	   left join receipts_generation rg on rg.tenant_contract_id=tc.id group by tc.id)a on a.id=tc.id	

left join (select tc.id, sum(rgd.credit_amount) as Other_due from receipts_generation_dim rgd
 join receipts_generation rg on rg.id = rgd.receipts_generation_id
 join tenant_contracts tc on tc.id = rg.tenant_contract_id
 join acc_codes ac on ac.id=rgd.ac_codes_id
where ac.acc_code_val not in ('41105','41110','22311') and rg.receipts_generation_type <>'2'
group by tc.id) as w on w.id=tc.id 
where tc.tenant_renewal_termination_status ='8' 
) as h 
where h.termination_status = '3' and h.terminationtype = '1' and h.vaccated_on between $P{Date1} and $P{Date2}
order by h.buildingname]]>
	</queryString>
