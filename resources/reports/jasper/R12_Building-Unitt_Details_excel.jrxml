	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="170"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="823"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/"]]></defaultValueExpression>
	</parameter>
	<parameter name="building_code" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="management_types_name" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT b.building_code as building_code,b.building_name as building_name,ut.id as id,u.unit_code as ucode,u.unit_floor as floor_no,u.unit_no as uno,u.unit_floor as ufloor,
	ut.unit_types_name as utype,u.unit_electric_consumer_no as u_eleno,
	u.unit_water_consumer_no as u_watno,l.locations_name
FROM units u left  join unit_types ut on ut.id = u.unit_type_id 
	 join buildings b on b.id = u.building_id 
	 join locations l on l.id=b.location_id
	 join management_types mt on mt.id=b.management_id
	where ( u.unit_status = 1) and (b.building_status = '1') 
	and (b.building_code =$P{building_code} or b.building_name =$P{building_name} or mt.management_types_name=$P{management_types_name})
order by u.unit_code asc]]>
	</queryString>
