	<parameter name="logo" class="java.lang.String"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[select distinct f.months,l.updated_at::date,b.building_name,u.unit_no,t.tenant_name,tc.tenant_contract_valid_to_date as AgrmntExpire,
a.renteff_to,
case 
when y.collected_amt is null then f.months * tc.tenant_contract_rent
else (f.months * tc.tenant_contract_rent)- y.collected_amt end as rent_due,
(now()::date - tc.tenant_contract_start_date::date) as days,
tc.tenant_contract_rent,
mt.management_types_name,l.note,
case u.unit_vaccant_status
when 0 then 'Vaccant'
else 'Occupied'
end as unit_vaccant_status,e.employee_name as are,tc.tenant_contract_last_paid_date as lastpaymentdate
from legal l
left join buildings b on b.id = l.building_id 
left join units u on u.id = l.unit_id
left join tenant_contracts tc on tc.id = l.tenant_contract_id
left join tenant t on t.id = tc. tenant_id
left join receipts_generation rg on tc.id=rg.tenant_contract_id
left join management_types mt on mt.id=b.management_id
left join (SELECT tenant_contract_no,sum(rg.receipts_generation_amt) as receiptgeneration_amt
                from tenant_contracts tc 
				left join receipts_generation rg on rg.tenant_contract_id=tc.id 
				group by tenant_contract_no)c on c.tenant_contract_no=tc.tenant_contract_no
left join (SELECT tenant_contract_no,max(rg.receipts_generation_eff_to) as renteff_to
                from tenant_contracts tc 
				left join receipts_generation rg on rg.tenant_contract_id=tc.id 
				group by tenant_contract_no)a on a.tenant_contract_no=tc.tenant_contract_no
 left join (SELECT pb.building_id,employee_name from employees emp
		   left join users us on emp.id = us.user_type_id
		   left join are_buildings are on us.id=are.user_id
		   left join preferred_buildings pb on are.id=pb.are_building_id
		   where pb.assign_to is null)e on e.building_id = b.id
left join (select tc.id,sum(receipts_generation_amt) as collected_amt from receipts_generation rg
		   left join tenant_contracts tc on tc.id = rg.tenant_contract_id
		   left join buildings b on b.id = tc.building_id group by tc.id) as y on y.id=tc.id
left join (select distinct leg.tenant_contract_id,
		case when (SELECT EXTRACT(MONTH FROM max(tenant_contract_valid_to_date))) >= (SELECT EXTRACT(MONTH FROM max(tenant_contract_start_date)))
		then
		(SELECT (DATE_PART('year', max(tenant_contract_valid_to_date)) - DATE_PART('year', max(tenant_contract_start_date))) * 12 +
             	 (DATE_PART('month', max(tenant_contract_valid_to_date)) - DATE_PART('month', max(tenant_contract_start_date))))
		else
		(SELECT (DATE_PART('year', max(tenant_contract_valid_to_date)) - DATE_PART('year', max(tenant_contract_start_date))) * 12 +
              (DATE_PART('month', max(tenant_contract_valid_to_date)) - DATE_PART('month', max(tenant_contract_start_date))))+1
		end as months
		from legal leg
			left join tenant_contracts tc on tc.id = leg.tenant_contract_id
		  	group by leg.tenant_contract_id) f on f.tenant_contract_id = tc.id		   
		   
where l.work_flow_processes_code='803' and (l.updated_at::date between $P{Date1} and $P{Date2} )]]>
	</queryString>
