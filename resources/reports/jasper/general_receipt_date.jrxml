	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="acc_code_val" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select c.paymentmethod,c.ac_name,c.BuildingName,c.DocNo,c.DocDate,c.remark,c.AgreementNo,c.tenantcode,c.tenantname,c.unitno,c.amount,c.AC from
(select b.building_name as BuildingName,rg.receipts_generation_receipt_no as DocNo,
rg.receipts_generation_receipt_date as DocDate ,rg.receipts_generation_cheque_no as remark,
tc.tenant_contract_no as AgreementNo,t.tenant_code as tenantcode,t.tenant_name as tenantname,
u.unit_no as unitno,case when rgd.debit_amount > 0 Then rgd.debit_amount else rgd.credit_amount end as amount,ac.acc_code_val  ac,ac.acc_code_desc as ac_name,
case when rg.receipts_generation_payment_method = 1 then 'Cheque' else 'Cash' end as paymentmethod
from receipts_generation rg  
left join tenant_contracts tc on rg.tenant_contract_id=tc.id
left join tenant t on tc.tenant_id=t.id
left join units u on tc.unit_id=u.id
left join buildings b on u.building_id=b.id 
left join receipts_generation_dim rgd  on rgd.receipts_generation_id=rg.id
left join acc_codes ac on ac.id=rgd.ac_codes_id
where ( rg.receipts_generation_type='1' and (rg.receipts_generation_receipt_date between $P{Date1} and  $P{Date2}))
)c]]>
	</queryString>
