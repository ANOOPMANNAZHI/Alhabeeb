<!-- Created with Jaspersoft Studio version 6.11.0.final using JasperReports Library version 6.11.0-0c4056ccaa4d25a5a8c45672d2f764ea3498bebb  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="buildingreport" pageWidth="1320" pageHeight="1200" columnWidth="1280" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5a60b1dd-b84e-4a52-a4bd-105affc0f66a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS16122020"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="170"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="823"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT w.*,tenc.tenant_contract_rent,a.renteffectiveto,d.Nofpdc,f.lastregdate ,tn.tenant_name,
     case when b.lastrenwaldate between $P{Date1} and $P{Date2} then b.lastrenwaldate else null end as lastrenwaldate,
     case when f.lastregdate >= b.lastrenwaldate then f.lastregdate else null end as lastregdate
FROM 
	(SELECT distinct r.idtc as tcid,e.employee_name as emply_name,bl.building_name as bldgname,un.unit_no as unitno,ut.unit_types_name as untype,
	 r.contract as contract,r.expdate as expirydate
	 FROM tenant_contracts tc 
	 left join buildings bl on bl.id=tc.building_id
	 left join (SELECT pb.building_id,employee_name from employees emp
			   left join users us on emp.id = us.user_type_id
			   left join are_buildings are on us.id=are.user_id
			   left join preferred_buildings pb on are.id=pb.are_building_id
			   where pb.assign_to is null)e on e.building_id = bl.id 
	left join units un on tc.unit_id=un.id
	left join unit_types ut on ut.id = un.unit_type_id 
	left join (SELECT u.unit_no,max(tec.tenant_contract_no) as contract,
			   max(tec.tenant_contract_valid_to_date) as expdate,
			   max(tec.tenant_contract_old_no)as oldcontrct,
			   max(tec.id) as idtc
			   from tenant_contracts tec
 			   left join units u on u.id = tec.unit_id
	 	   	   group by u.unit_no)r on r.unit_no=un.unit_no 
	left join renewals rw on rw.old_contract_id = tc.id
	left join termination tr on tr.contract_id = tc.id
	where rw.work_flow_processes_code is null
	and tr.work_flow_processes_code is null
	and bl.building_status = 1
	order by un.unit_no)as w
	
LEFT JOIN tenant_contracts tenc on tenc.tenant_contract_no = w.contract
LEFT JOIN (SELECT tenant_contract_no,max(rg.receipts_generation_eff_to) as renteffectiveto
           from tenant_contracts tc 
           left join receipts_generation rg on rg.tenant_contract_id=tc.id 
           group by tenant_contract_no)a on a.tenant_contract_no=w.contract
LEFT JOIN (SELECT r.new_contract_id,max(r.updated_at) as lastrenwaldate
		   from renewals r 
           group by r.new_contract_id)b on b.new_contract_id =w.tcid
LEFT JOIN (SELECT tenant_contract_id,count(p.tenant_contract_id) as Nofpdc from pdc p
 	       group by tenant_contract_id)d on d.tenant_contract_id=tenc.id	
LEFT JOIN (SELECT rnw.new_contract_id,max(tnc.tenant_contract_registered_date) as lastregdate
           from tenant_contracts tnc
 		   left join renewals rnw on rnw.old_contract_id = tnc.id
           group by rnw.new_contract_id)f on f.new_contract_id =w.tcid
LEFT JOIN tenant tn on tn.id = tenc.tenant_id
		   				  		   
WHERE (tenc.tenant_contract_valid_to_date between $P{Date1} and $P{Date2})
OR  (b.lastrenwaldate between $P{Date1} and $P{Date2})
order by w.bldgname,w.unitno]]>
	</queryString>
