<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="R1 Tenancy Details" language="javascript" pageWidth="1230" pageHeight="1150" orientation="Landscape" columnWidth="1190" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e1d93b-2fdc-48d5-bc52-1e8512fe354d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Plms "/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="140"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="853"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="633"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="353"/>
	<parameter name="username" class="java.lang.String"/>
	<parameter name="building" class="java.lang.String"/>
	<parameter name="buildingcode" class="java.lang.String"/>
	<parameter name="created_at" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[select distinct  u.unit_code,u.unit_no,ut.unit_types_name,b.building_name,b.building_code,tc.tenant_contract_no,
tc.tenant_contract_start_date,tc.tenant_contract_valid_to_date,tc.unit_usage,tn.tenant_name,tn.tenant_contact_no,
t.termination_date,tc.tenant_contract_last_paid_date,pm.payment_method_code,
case when u.unit_vaccant_status=0 then 'Yes' else 'No' end as is_vaccant,
case when tc.tenant_contract_no is null then u.unit_base_rent::float else tc.tenant_contract_rent end as rent
 from
(select u.unit_code,max(tc.id) as id
  from units u
  left join tenant_contracts tc on tc.unit_id=u.id
  group by u.unit_code) as a
  left join units u on a.unit_code=u.unit_code
  left join tenant_contracts tc on a.id=tc.id
  left join buildings b on b.id = u.building_id
  left join landlord_contract lc on b.id=lc.building_id
    left join unit_types ut on ut.id = u.unit_type_id
    left join tenant tn on tc.tenant_id=tn.id
      left join termination t on t.contract_id=a.id
        left join payment_method pm on tc.tenant_contract_payment_type=pm.payment_method_index
  where b.building_name='inest' and lc.landlord_contract_valid_from_date<=now()
order by u.unit_code]]>
	</queryString>
