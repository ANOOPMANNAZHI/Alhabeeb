	<parameter name="username" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select a.works_code as category,a.count as NoofComplaints,b.categorycount as categorycount,
ROUND((a.count *100.0/b.categorycount),2)as Percentage  from
(select w.works_code,cc.work_id,

count(cc.work_id) as count
 from  complaint_checklists cc
 left join works w on w.id=cc.work_id
 left join complaint_enquiries ce on ce.id=cc.complaint_enquiries_id
where ce.complaint_date between $P{Date1} and  $P{Date2}
 group by cc.work_id,w.works_code)a,

(select count(cc.work_id) as categorycount from complaint_checklists cc
left join works w on w.id=cc.work_id
left join complaint_enquiries ce on ce.id=cc.complaint_enquiries_id
where ce.complaint_date between $P{Date1} and  $P{Date2}
 )b]]>
	</queryString>
	<field name="category" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="category"/>
	</field>
	<field name="noofcomplaints" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="noofcomplaints"/>
	</field>
	<field name="categorycount" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="categorycount"/>
	</field>
	<field name="percentage" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="percentage"/>
	</field>
	<variable name="percentage_SUM" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{percentage}]]></variableExpression>
	</variable>
