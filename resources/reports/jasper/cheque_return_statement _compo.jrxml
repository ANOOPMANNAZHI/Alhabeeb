<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="chequereturnstatement" pageWidth="1200" pageHeight="740" columnWidth="1160" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e1d93b-2fdc-48d5-bc52-1e8512fe354d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="108"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="885"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="776"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="210"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS11112020"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="employee_name" class="java.lang.String"/>
	<parameter name="Date2" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[select distinct tc.tenant_contract_no,pdc.pdc_is_posted,b.building_name as building,e.employee_name as are,u.unit_no as unit,
t.tenant_name as tenantname,
pdc.pdc_check_no as chequeno,
pdc.pdc_check_date as chequedate,bk.bank_name as bankname 
,pdc.pdc_amt as chequeamt ,
case  when pdc.pdc_settlement = '2' then x.receipt_no else 'Not Settled'
end as actiontaken,
case when pdc.pdc_settlement = '2' then '0.00' else pdc.pdc_amt
end as notsettledamount,
t.gsm_no,tc.tenant_contract_rent,
a.renteff_to
 from buildings b 
left join units u on u.building_id=b.id
left join tenant_contracts tc on tc.unit_id=u.id
left join tenant t on tc.tenant_id=t.id
left join pdc on pdc.tenant_contract_id=tc.id
left join bank bk on pdc.bank_id=bk.id
left join receipts_generation rg on rg.tenant_contract_id=tc.id
left join (SELECT tc.id,sum(rg.receipts_generation_amt) as receiptgeneration_amt
	   from tenant_contracts tc
	   left join receipts_generation rg on rg.tenant_contract_id=tc.id group by tc.id)c on c.id=tc.id
left join (SELECT tc.id,max(rg.receipts_generation_eff_to) as renteff_to
	   from tenant_contracts tc
	   left join receipts_generation rg on rg.tenant_contract_id=tc.id group by tc.id)a on a.id=tc.id
left join (SELECT tc.id,max(rg.receipts_generation_receipt_no) as receipt_no
	   from tenant_contracts tc
	   left join receipts_generation rg on rg.tenant_contract_id=tc.id group by tc.id)x on x.id=tc.id	   
left join (SELECT pb.building_id,employee_name from employees emp
		   left join users us on emp.id = us.user_type_id
		   left join are_buildings are on us.id=are.user_id
		   left join preferred_buildings pb on are.id=pb.are_building_id
		   where pb.assign_to is null)e on e.building_id = b.id	   	   	   
where  pdc.pdc_cancel_reason = '1'  and  (pdc.pdc_check_date between $P{Date1} and $P{Date2})
and  (b.building_name =  $P{building_name} or e.employee_name = $P{employee_name})]]>
	</queryString>
