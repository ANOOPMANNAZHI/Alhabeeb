<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="landlordcontract_report" pageWidth="1464" pageHeight="1500" orientation="Landscape" columnWidth="1424" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="57e1d93b-2fdc-48d5-bc52-1e8512fe354d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="287"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="702"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="750"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="235"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS"/>
	<parameter name="username" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct ce.complaint_date,ce.complaint_no,b.building_name,
case when b.building_maintenance_info=0 then 'Managed by us' else 'Not Managed by us' end as maintainedby,
CASE WHEN cc.assigned_to_type=0 AND cc.assigned_to= e.id THEN e.employee_name
     WHEN cc.assigned_to_type=1 AND cc.assigned_to=v.id THEN v.vendor_name END AS Supervisor,
u.unit_code,w.works_code as category,cc.checklist_desc as complaintdesc,em.employee_name as assignedto,e.employee_name as subassignedto,ce.complainer_name,
case when ce.complaint_status=2 then ce.updated_at end as closedon,ur.username,
case when ce.complaint_status=0 then 'Open'
     when ce.complaint_status=1 then 'Inprogress'
     when ce.complaint_status=2 then 'Closed' end as status
from complaint_enquiries ce 
join buildings b on b.id = ce.building_id
join complaint_checklists cc on cc.complaint_enquiries_id =ce.id
left join users us on us.id=cc.sub_assigned_to
left join employees e on e.id=us.user_type_id
left join users use  on use.id=cc.assigned_to
join vendors v on b.vendor_id=v.id
left join employees em on em.id=use.user_type_id
left join units u on u.id = ce.unit_id
right join works w on w.id = cc.work_id
left join users ur on ur.id=ce.created_by
where (ce.updated_at::date between $P{Date1} and $P{Date2})
and (ce.complaint_status=2)
order by ce.complaint_no desc]]>
	</queryString>
