      }
        console.log(data_details)
         $.ajax({
               type: "POST",
             url: "{{route('collectionMTD')}}",         
               data: data_details,
               success: function(data){     

               const formatToCurrency = amount => {
                  return  amount.toFixed(3).replace(/\d(?=(\d{3})+\.)/g, "$&,");
                };

                formatdata = formatToCurrency(Number(data));

                       
               $('.collection_MTD_count').html(formatdata)
              }
            });
         
       
    });
     $('#unitType_select').change(function (event) {
      
        var id = $(this).attr('id');
        var select_value = $(this).val();

        var  data_details = {};
        
        if(select_value != '')
        data_details['unitType'] = select_value;


        data_details['_token'] =  "{{ csrf_token() }}";

        //if(id == 'collection_MTD'){
         if($('#unitTypeDate_select').val() != '')
         data_details['unitTypeDate_select'] = $('#unitTypeDate_select').val();  
      //}
     // console.log(data_details); return false;
         $.ajax({
           type: "POST",
           url: "{{route('md-dashboard')}}",
           data: data_details,
           success: function(data){
          
            var areaRent = Object.values(data.rent.value.averageReceivables);
            var area = Object.values(data.rent.area);
            
            myChart_Chart6.data.labels = area;
            myChart_Chart6.data.datasets[1].data = areaRent;
            myChart_Chart6.update();
          }
        });
    
         
       
    });
    function updateData(event,e){
      
      var are_id = e.value;

      if(are_id){
         $.ajax({
           type: "POST",
           url: "{{route('md-dashboard')}}",
           data: {"_token":"{{ csrf_token() }}","count_type":'areSalepersonHitRatio',"selected_are":are_id},
           success: function(data){
            var result = $.parseJSON(data);
            
            console.log( result);
            var sal = result.saleList;
            var salesperson =[];
            var won =[];
            var assign =[];
            var inprogress =[];
            var closed = [];
            result.saleList.forEach(function(item, index){
                    
                    salesperson.push(item);
             });
            result.assigned.forEach(function(item, index){
                    
                    assign.push(item);
             });
            result.won.forEach(function(item, index){
                    
                    won.push(item);
             });
            result.pgrs.forEach(function(item, index){
                    
                    inprogress.push(item);
             });
            result.clsd.forEach(function(item, index){
                    
                    closed.push(item);
             });

            data = { "salesperson" :salesperson,
                     "assigned":assign,
                      "won": won,
                      "inprogress":inprogress,
                      "closed": closed,
                      "null_value": ["'"+
                        result.null_value+"'"       
                      ]
                  };
               console.log(myChart_sale.data);

            myChart_sale.data.labels = data.salesperson;
            myChart_sale.data.datasets[1].data = data.assigned;
            myChart_sale.data.datasets[2].data = data.won;
            myChart_sale.data.datasets[3].data = data.inprogress;
            myChart_sale.data.datasets[4].data = data.closed;
            //myChart_sale.data.datasets[3].data = data.null_value;
            myChart_sale.update();
          }
        });
      }
      else{

        $.ajax({
           type: "POST",
           url: "{{route('md-dashboard')}}",
           data: {"_token":"{{ csrf_token() }}","count_type":'areSalepersonHitRatioDefault'},
           success: function(data){
            var result = $.parseJSON(data);
            //console.log( result);
          
            var salesperson =[];
            var won =[];
            var assign =[];
            var inprogress =[];
            var closed = [];
            result.name.forEach(function(item, index){
                    
                    salesperson.push(item);
             });

            result.value.assigned.forEach(function(item, index){
                    
                    assign.push(item);
             });
            result.value.won.forEach(function(item, index){
                    
                    won.push(item);
             });

            result.value.pgrs.forEach(function(item, index){
                    
                    inprogress.push(item);
             });
            result.value.clsd.forEach(function(item, index){
                    
                    closed.push(item);
             });

            data = { "salesperson" :salesperson,
                     "assigned":assign,
                     "won": won,
                     "inprogress":inprogress,
                      "closed": closed,
                     "null_value": ["'"+
                        result.null_value+"'"       
                      ]
                  };
             
            myChart_sale.data.labels = data.salesperson;
            myChart_sale.data.datasets[1].data = data.assigned;
            myChart_sale.data.datasets[2].data = data.won;
            myChart_sale.data.datasets[3].data = data.inprogress;
            myChart_sale.data.datasets[4].data = data.closed;
            //myChart_sale.data.datasets[3].data = data.null_value;
            myChart_sale.update();
          }
        });

  }   
  }
