    var compData = @json($managingDirector['vacantUnitWithUnitType']['comprehensive']);
    var normalData = @json($managingDirector['vacantUnitWithUnitType']['normal']);
  
  window.myBarChartVacant;
  loadVacantUnitChart(compData,normalData);

 function loadVacantUnitChart(compData,normalData){

 
  window.myBarChartVacant = undefined;
  window.dataG = undefined;
  window.tempVal = undefined;
  window.tempArr = undefined;

  var tempVal = [];
  for(const[unitType,value] of Object.entries(compData)){

     
    var tempArr = [];

    var tempArr = {

      label:unitType,
      stack:1,
      categoryPercentage: 1,
      backgroundColor:getRandomColor(),
      data:[value[30],
      value[60],
      value[90],
      value[120],
      value[121]]
    };
            tempVal.push(tempArr);
  }
  for(const[unitType,value] of Object.entries(normalData)){
    var tempArrNormal = [];
    var tempValsNormal = [];
    var tempValsNormal = {label:unitType,stack:2,categoryPercentage: 1,backgroundColor:getRandomColor(),data:[value[30],value[60],value[90],value[120],value[121]]};
          tempVal.push(tempValsNormal);
  }

  let dataG = {
    labels: ["0-30", "30-60", "60-90","90-120","120+"],
    datasets: tempVal      
  };
         var ctx = document.getElementById("Chart2").getContext("2d");
         if(window.myBarChartVacant){
            window.myBarChartVacant.destroy();
         }
       // myBarChartVacant ='';
         window.myBarChartVacant   = new Chart(ctx, {
             type: 'bar',
             data: dataG,
             options: {
                 responsive: true,
                 legend: {
                     position: 'top',
                 },
                 title: {
                     display: true,
                     text: 'Vacant Unit'
                 },
                 scales: {
                  yAxes: [{
                      ticks: {
                          beginAtZero: true,
                          maxRotation: 0,
                          minRotation: 0,
                          //max :1500
                      },
                      stacked:true
                  }],
                  xAxes: [{
                      ticks: {
                        display: false
                      }
                      },
                      {
                        type: 'category',
                        offset: true,
                        labels: [ 'Comprehensive', 'Normal', 'Comprehensive','Normal', 'Comprehensive','Normal', 'Comprehensive','Normal'],
                        gridLines: {
                          display: false
                        }
                      },
                      {
                        offset: true,
                        gridLines: {
                          display: false
                        }
                      }]
                 }
                 //onClick : clickHandler()
             },
             
         });
 }     

