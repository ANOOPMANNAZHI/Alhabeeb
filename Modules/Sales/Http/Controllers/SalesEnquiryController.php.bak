    /**
     * Update the specified resource in storage.
     * @param  Request $request
     * @return Response
     */
    public function enquiryEditPopupAction(Request $request,SalesEnquiry  $enquiry)
    {

      $this->validate($request, [
        'sales_mobile_no' => 'required|regex:/^((\+)?(\d{2,3}))?(\d{8}){1}?$/',           
        'sales_region' => 'required',           
        'sales_enquiry_name' => 'required|max:75',
        'sales_email' => 'nullable|email',         
        'location_id' => 'required',         
        'price_range_id' => 'required',         
        'sales_size' => 'numeric|nullable',         
        'building_type_id' => 'required_if:sales_type,2',
        'month' => 'required_if:sales_type,1',
        'year' => 'required_if:sales_type,1',

        ]);        
      $enquiry =   SalesEnquiry::where('id',$request->sales_enquiry_id)->first();
      if($request->sales_type == 1){
       $request->unit_type_id  = explode(',',$request->unit_type_id);
       $request->price_range_id  = explode(',',$request->price_range_id);
     }
     $sales_move_in_date = $request->year.'-'.$request->month.'-1';

     SalesEnquiry::where('id', $request->sales_enquiry_id)->update([
       'sales_mobile_no' => $request->sales_mobile_no,
       'sales_region'=>$request->sales_region,
       'sales_enquiry_name' => $request->sales_enquiry_name,
       'sales_email' => $request->sales_email,
       'sales_contact_address' => $request->sales_contact_address,          
       'sales_no_of_unit' => $request->sales_no_of_unit,       
       'sales_size' => $request->sales_size,
       'sales_mode_id' => $request->sales_mode_id,
       'sales_referred_by' => $request->sales_referred_by,
       'sales_note' => $request->sales_note, 
       'alternative_no' => $request->alternative_no,
       'tenant_type_id' => $request->tenant_type_id,
       'sales_move_in_date' =>$sales_move_in_date
       ]);

     


     activity('Update Tenant Enquiry')
     ->performedOn($enquiry)
     ->causedBy(\Auth::user()->id)
     ->withProperties($enquiry)
     ->log("Created Name :".\Auth::user()->username.", Created Email :".\Auth::user()->email);


     $enquiry->update();
     
     if($request->sales_type == 1){		 
       $enquiry->unitTypes()->sync($request->unit_type_id); 
     }


     $request->location_id = array_where($request->location_id, function ($value, $key) {
       if($value > 0)
        return true;
    });

     if(count($request->location_id) > 0) {		  
       $enquiry->locations()->sync($request->location_id); 
     }       

     $request->price_range_id = array_where($request->price_range_id, function ($value, $key) {
      if($value > 0)
        return true;
    });	  

     if(count($request->price_range_id) > 0) 
       $enquiry->priceRanges()->sync($request->price_range_id);


     if($request->sales_type == 2)       
       $price_range_id =  $location_id = null;
     else{
       $price_range_id = (count($request->price_range_id) > 0)?  $request->price_range_id[0] : null;
       $location_id = (count($request->location_id) > 0)? $request->location_id[0] : null;       

     }       
     $processFlow = 101;
     $sales =   Sales::where('sales_enquiry_id',$enquiry->id)  
     ->where('work_flow_processes_code',$processFlow)->first();

	  // Get Process Users
     $general =  new General;
     $processAssign = $general->roleUsersFromProcess($processFlow,$location_id,$price_range_id);

     
     $users = array();

     if($processAssign == false){

      $res =    $general->workFlowProcess($processFlow);
      $sales->salesUsers()->attach($res->default_role, ['user_id' => $res->default_user_id]);
      $sales->save();

      if(empty($res->default_user_id)){			 
        $users_list = \App\User::role($res->default_role)->get()->pluck('id'); 			 
        $users = $users_list->toArray();			  
      }else 
      $users[] = $res->default_user_id;



    }else{
     foreach($processAssign->assign as $val){
       $user_id = $val->user_id;
       if(empty($val->user_id))
        $user_id = null;
      $sales->salesUsers()->attach($val->role_id, ['user_id' => $user_id]);
      $sales->save();


      if(empty($user_id)){			 
        $users_list = \App\User::role($val->role_id)->get()->pluck('id'); 				 
        $users_list = $users_list->toArray();	
        $users_list = array_flatten($users_list);      

        if(count($users) > 0){
          $users = array_merge($users,$users_list); 
        }else			 		 
        $users = $users_list;			  
      }else 
      $users[] = $user_id;     


    }
  } 


  $users = array_flatten($users);      
  $users_notify =  \App\User::whereIn('id',$users)->get(); 

  session()->flash('success', ' Enquiry Updated ');
  return back();

}
    /*
     * 
     * Automatically Self Assign Enquiry to a salesperson if add salesperson added a enquiry
     * 
     * 
     */ 
    public function enquiryAddBySalesperson($enquiry_id){

      $workflow_id  = 101;
      $action_key   = 'AS';
      $roleid       =  2; // Selesperson role
      $userid       =  \Auth::user()->id;
      $enquiry_id   = $enquiry_id;
      $general      =  new General;
      $next_process_id = $general->nextProcessFromAction($workflow_id,$action_key);


      $enquiryDetails = SalesEnquiry::where('id','=',$enquiry_id)->first();

      $location       = $enquiryDetails->locations()->first();
      $location_id    = $location->id;
      $priceRange     = $enquiryDetails->priceRanges()->first();
      $pricerange_id  = $priceRange->id;

      $processAssign = $general->roleUsersFromProcess($next_process_id,$location_id,$pricerange_id,$tenant_status=null);

      $countSales = Sales::where('sales_enquiry_id',$enquiry_id)->count();
      if($countSales == 1) SalesEnquiry::where('id', $enquiry_id)->update([
        'enquiry_owner' => \Auth::user()->id,
        ]);

	  $sales = Sales::create([
          'sales_enquiry_id' =>$enquiry_id,
          'sales_type' => $enquiryDetails->sales_type,
          'work_flow_processes_code' => $next_process_id,
          'created_by' => \Auth::user()->id,
          ]);
          
      if($roleid == \Auth::user()->default_role){
          $sales->salesUsers()->attach($roleid,['user_id'=>$userid]);

      }
      else{
        $sales->salesUsers()->attach($roleid,['user_id'=>$userid]);
        $sales->salesUsers()->attach(\Auth::user()->default_role,['user_id'=>\Auth::user()->id]);
      }
      $sales->salesUsers()->attach(5);
      
      $enquiryDetails->update([
        'work_flow_processes_code' => $next_process_id,
        'assigned_person' => $userid,
        'updated_by' => \Auth::user()->id,
        ]);

      /****** Activity log *****/

      activity('Self Assign - Sales-person')
      ->performedOn($sales)
      ->causedBy(\Auth::user()->id)
      ->withProperties($sales)
      ->log("Created Name :".\Auth::user()->username.", Created Email :".\Auth::user()->email);

      
      session()->flash('success', 'Enquiry Added');
      return ;

    }
  }
