class SalesEnquiryController extends Controller
{
	public function __construct()
  {
    $this->middleware('auth'); 
    $this->middleware('permission:add_enquiry', ['only' => ['enquiry']]);
    $this->middleware('permission:edit_enquiry', ['only' => ['enquiry']]);
    $this->middleware('permission:view_enquiry', ['only' => ['enquiry']]);
    $this->noOfRecord  = prefixData('no_of_records_in_list_grid')->configuration_value;

  }
    /**
     * Display a listing of the resource.
     * @return Response
     */
    public function index()
    {   


     return view('sales::add_sales_enquiry');

   }

    /**
     * Show the form for creating a new resource.
     * @return Response
     */
    public function create(Request $request)
    { 
	  // 1 - tenant, 2 - landlord	
     $type = $request['type']?$request['type']:null;

     return view('sales::add_sales_enquiry',compact('type'));
   }

    /**
     * Store a newly created resource in storage.
     * @param  Request $request
     * @return Response
     */
    public function store(Request $request)
    {  

      //$loggedRoles = \Auth::user()->roles()->get()->pluck('name');
      //dd($loggedRoles);

      if($request->sales_type == 1){
       $prefix      = prefixData('tenant_enquiry_no_prefix')->configuration_value;
       $salesLatest = SalesEnquiry::where('sales_type',1)->where('sales_enquiry_direct_contract',1)->orderBy('id', 'desc')->first();
     }
     else{
       $prefix      = prefixData('landlord_enquiry_no_prefix')->configuration_value;
       $salesLatest = SalesEnquiry::where('sales_type',2)->where('sales_enquiry_direct_contract',1)->orderBy('id', 'desc')->first();
     }

     if(!empty($salesLatest)){
      $nextCode 	= $prefix.str_pad($salesLatest->enquiry_index+1,4,'0',STR_PAD_LEFT);
      $index 		= $salesLatest->enquiry_index+1;
    }
    else{
      $nextCode = $prefix.str_pad(1,4,'0',STR_PAD_LEFT);    
      $index = 1;
    }

    if($request->sales_type == 1){
     $request->unit_type_id  = explode(',',$request->unit_type_id);
     $request->price_range_id  = explode(',',$request->price_range_id);
     if(!empty($salesLatest)){
      $nextCode = $prefix.str_pad($salesLatest->enquiry_index+1,4,'0',STR_PAD_LEFT);
      $index 	= $salesLatest->enquiry_index+1;
    }else{
      $nextCode = $prefix.str_pad(1,4,'0',STR_PAD_LEFT); 
      $index 	= 1;
    }
  }    

  $this->validate($request, [
    'sales_mobile_no' => 'required|regex:/^((\+)?(\d{2,2}))?(\d{13}){1}?$/',           
    /*'sales_region' => 'required', */          
    'sales_enquiry_name' => 'required|max:75',
    'sales_email' => 'nullable|email',         
    /*          'sales_contact_address' => 'required|max:250' , */       
    'unit_type_id' => 'required_if:sales_type,1',         
          /*'sales_no_of_unit' => 'required',        
          'location_id' => 'required',         
          'price_range_id' => 'required',*/          
    //      'sales_size' => 'numeric',         
          /*'tenant_type_id' => 'required_if:sales_type,1',*/         
         // 'building_type_id' => 'required_if:sales_type,2',           
          'year' => 'required_if:sales_type,1',
          'month' => 'required_if:sales_type,1',
          
        //  'sales_building_name' => 'required_if:sales_type,2'
          ]);   




  $salesEnquiry = new SalesEnquiry;
  $salesEnquiry->sales_enquiry_no = $nextCode;
  $salesEnquiry->sales_type = $request->sales_type; 
  $salesEnquiry->sales_mobile_no = $request->sales_mobile_no; 
  /*$salesEnquiry->sales_region = $request->sales_region;*/  
  $salesEnquiry->sales_enquiry_name = $request->sales_enquiry_name;
  $salesEnquiry->sales_email = $request->sales_email;
         //$salesEnquiry->sales_contact_address = $request->sales_contact_address;          
  $salesEnquiry->alternative_no = ($request->alternative_no === '00968')?'':$request->alternative_no;       
  $salesEnquiry->sales_size = $request->sales_size;
         /*$salesEnquiry->sales_mode_id = $request->sales_mode_id;
         $salesEnquiry->sales_referred_by = $request->sales_referred_by;*/

         
         $salesEnquiry->created_by = \Auth::user()->id;
         $salesEnquiry->sales_note = $request->sales_note;         

         if($request->sales_type == 1){
           $sales_move_in_date = $request->year.'-'.$request->month.'-1';
           $salesEnquiry->tenant_type_id = $request->tenant_type_id;
           $salesEnquiry->sales_move_in_date = $sales_move_in_date; 
           $salesEnquiry->sales_mode_id = $request->sales_mode_id;
           $salesEnquiry->sales_referred_by = $request->sales_referred_by;
           $salesEnquiry->sales_no_of_unit = $request->sales_no_of_unit;
           $salesEnquiry->sales_region = $request->sales_region; 
           $salesEnquiry->enquiry_index = $index ;  
           $salesEnquiry->sales_enquiry_direct_contract = 1; // Normal Contract 
           $processFlow = 101;
         }else{
           $salesEnquiry->sales_building_name = $request->sales_building_name;
           $salesEnquiry->sales_contact_address = $request->sales_contact_address; 
           $salesEnquiry->sales_company_name = $request->sales_company_name;
           $salesEnquiry->sales_no_of_unit = $request->sales_no_of_unit;
           $salesEnquiry->building_type_id = $request->building_type_id; 
           $salesEnquiry->sales_region = $request->sales_region; 
           $salesEnquiry->sales_mode_id = $request->sales_mode_id;
           $salesEnquiry->sales_referred_by = $request->sales_referred_by;
           $salesEnquiry->enquiry_index = $index ; 
           $salesEnquiry->sales_enquiry_direct_contract = 1; // Normal Contract 
           $processFlow = 201; 
         }  

         $salesEnquiry->work_flow_processes_code = $processFlow;
         $salesEnquiry->enquiry_owner = \Auth::user()->id;
         $salesEnquiry->save();  
         
         if($request->sales_type == 1)
          $salesEnquiry->unitTypes()->sync($request->unit_type_id); 


        if($request->location_id ){         

          $request->location_id = array_where($request->location_id, function ($value, $key) {
           if($value > 0)
            return true;
        });
          if(count($request->location_id) > 0)     
            $salesEnquiry->locations()->sync($request->location_id); 
        }
        if($request->price_range_id ){
          if(count($request->price_range_id) > 0) {
            $request->price_range_id = array_where($request->price_range_id, function ($value, $key) {
             if($value > 0)
              return true;
          });
            $salesEnquiry->priceRanges()->sync($request->price_range_id);
          }
        }

       /*if(count($request->price_range_id) > 0) 
       $salesEnquiry->priceRanges()->sync($request->price_range_id);*/

    //}

       $salesEnquiry->save();

       if($request->sales_type == 2)       
        $price_range_id =  $location_id = null;
      else{
       $price_range_id = (count($request->price_range_id) > 0)?  $request->price_range_id[0] : null;
       $location_id = (count($request->location_id) > 0)? $request->location_id[0] : null;       

     } 
     

     $sales =   Sales::create([
      'sales_enquiry_id' =>$salesEnquiry->id,
      'sales_type' => $salesEnquiry->sales_type,
      'work_flow_processes_code' => $processFlow,
      'created_by' => \Auth::user()->id,
      ]);

     $general =  new General;
     $processAssign = $general->roleUsersFromProcess($processFlow,$location_id,$price_range_id);

     $users = array();

     if($processAssign == false){

      $res =    $general->workFlowProcess($processFlow);

      $sales->salesUsers()->attach($res->default_role, ['user_id' => $res->default_user_id]);
      $sales->save();

      if(empty($res->default_user_id)){			 
        $users_list = \App\User::role($res->default_role)->get()->pluck('id'); 			 
        $users = $users_list->toArray();			  
      }else 
      $users[] = $res->default_user_id;



    }else{

     foreach($processAssign->assign as $val){
       $user_id = $val->user_id;

       if(empty($val->user_id))
         $user_id = null;

       $sales->salesUsers()->attach($val->role_id, ['user_id' => $user_id]);
       $sales->save();

       if(empty($user_id)){			 
        $users_list = \App\User::role($val->role_id)->get()->pluck('id'); 				 
        $users_list = $users_list->toArray();	
        $users_list = array_flatten($users_list);   
        if(count($users) > 0){
          $users = array_merge($users,$users_list); 			  	  
        }else			 		 
        $users = $users_list;			  
      }else 
      $users[] = $user_id;      

    } 
  }
  $users = array_flatten($users);      
  $users_notify =  \App\User::whereIn('id',$users)->get();
   $roles = \Auth::user()->getRoles()->all();

  if(in_array(2, $roles) && $request->sales_type == 1){

            // Direct assign to salesperson
    $this->enquiryAddBySalesperson($salesEnquiry->id);
    return redirect()->route('tenantEnquiries');

  } 
  else{

    event(new NewEnquiry($salesEnquiry,$users_notify));  //internal Notification
    $sales_email = $request->sales_email;
    $sales_mobile = $request->sales_mobile_no;
    $alternative_mobile = $request->alternative_no;
    $mobile = $sales_mobile ?? $alternative_mobile;
    //dd($mobile);
    $msg = 'New Enquiry Added !';
    $params = 'optional data';
    if(!empty($sales_email)){
      Mail::to($sales_email)->send(new SalesEnquiryEmail($salesEnquiry)); //Email Notification
    }else{
      sendSms($mobile,$msg,$params); //SMS Notification
    }
    



    session()->flash('success', ' Enquiry Added ');

    if($request->sales_type == 1){
     activity('Tenant Enquiry')
     ->performedOn($salesEnquiry)
     ->causedBy(\Auth::user()->id)
     ->withProperties($salesEnquiry)
     ->log("Created Name :".\Auth::user()->username.", Created Email :".\Auth::user()->email);

     return redirect()->route('tenantEnquiries');
   }else{

     activity('LandlordEnquiry Enquiry')
     ->performedOn($salesEnquiry)
     ->causedBy(\Auth::user()->id)
     ->withProperties($salesEnquiry)
     ->log("Created Name :".\Auth::user()->username.", Created Email :".\Auth::user()->email);
     return redirect()->route('landlordEnquiries');
   }
 }
}

    /**
     * Show the specified resource.
     * @return Response
     */
    public function show(SalesEnquiry  $enquiry)
    {
      $id = $enquiry->id;  
      $allNotes = Sales::with('workFlowProcess')->where('sales_enquiry_id','=',$id)
      ->where('sales_notes', '!=', null)->get();
      $salesNotes = SalesNote::whereHas('sales', function ($query) use($id) {
        $query->where('sales_enquiry_id', '=', $id);                      
      })->get();
      //dd($salesNotes);
      clearNotification('Modules\Sales\Notifications\EnquiryNotification',$enquiry->id);
      return view('sales::view_sales_enquiry',compact('enquiry','allNotes','salesNotes'));
    }

    /**
     * Show the form for editing the specified resource.
     * @return Response
     */
    public function edit(Request $request,SalesEnquiry  $enquiry)
    {
      $type = $request['type']?$request['type']:null;
      $url = url()->previous();

      Session::put('url', $url);
      return view('sales::add_sales_enquiry',compact('enquiry','url','type'));
    }

    /**
     * Update the specified resource in storage.
     * @param  Request $request
     * @return Response
     */
    public function update(Request $request,SalesEnquiry  $enquiry)
    {

	  $url = Session::get('url');
	  $this->validate($request, [
		'sales_mobile_no' => 'required|regex:/^((\+)?(\d{2,2}))?(\d{13}){1}?$/',           
		  //'sales_region' => 'required',           
		'sales_enquiry_name' => 'required|max:75',
		'sales_email' => 'nullable|email',         
		/*'sales_contact_address' => 'required|max:250' ,*/        
		/*'sales_no_of_unit' => 'required',*/         
		  //'location_id' => 'required',         
		  //'price_range_id' => 'required',         
		'sales_size' => 'numeric|nullable',         
		/*'tenant_type_id' => 'required_if:sales_type,1', */        
		//'building_type_id' => 'required_if:sales_type,2',

		'month' => 'required_if:sales_type,1',
		'year' => 'required_if:sales_type,1',

		 // 'sales_building_name' => 'required_if:sales_type,2'
		]);        


      if($enquiry->sales_type == 1){
       $request->unit_type_id  = explode(',',$request->unit_type_id);
       $request->price_range_id  = explode(',',$request->price_range_id);
	  }

     

		$enquiry->sales_mobile_no = $request->sales_mobile_no; 
		$enquiry->sales_region = $request->sales_region;  
		$enquiry->sales_enquiry_name = $request->sales_enquiry_name;
		$enquiry->sales_email = $request->sales_email;
		$enquiry->sales_contact_address = $request->sales_contact_address;          
		$enquiry->sales_no_of_unit = $request->sales_no_of_unit;       
		$enquiry->sales_size = $request->sales_size;
		$enquiry->sales_mode_id = $request->sales_mode_id;
		$enquiry->sales_referred_by = $request->sales_referred_by;
		$enquiry->sales_note = $request->sales_note; 
		$enquiry->alternative_no = $request->alternative_no; 


		if($enquiry->sales_type == 1){

		   $sales_move_in_date = $request->year.'-'.$request->month.'-1';

		   $enquiry->tenant_type_id = $request->tenant_type_id;
		   $enquiry->sales_move_in_date = $sales_move_in_date; 
		   /*$enquiry->sales_company_name = $request->sales_company_name;*/
		   $processFlow = 101;
		   activity('Update Tenant Enquiry')
		   ->performedOn($enquiry)
		   ->causedBy(\Auth::user()->id)
		   ->withProperties($enquiry)
		   ->log("Created Name :".\Auth::user()->username.", Created Email :".\Auth::user()->email);

		}else{
		  activity('Update Landlord Enquiry')
		  ->performedOn($enquiry)
		  ->causedBy(\Auth::user()->id)
		  ->withProperties($enquiry)
		  ->log("Created Name :".\Auth::user()->username.", Created Email :".\Auth::user()->email);
		  $enquiry->sales_building_name = $request->sales_building_name;
		  $enquiry->building_type_id = $request->building_type_id;
		  $enquiry->sales_company_name = $request->sales_company_name;
		  $processFlow = 201;
		}  
		$enquiry->save();

		if($enquiry->sales_type == 1){		 
		 $enquiry->unitTypes()->sync($request->unit_type_id); 
		}

		//	dd($request->unit_type_id);

	   /*if($request->sales_type == 1){   */
		if($request->location_id ){	
		  $request->location_id = array_where($request->location_id, function ($value, $key) {
		   if($value > 0)
			return true;
		});

		if(count($request->location_id) > 0) {		  
			$enquiry->locations()->sync($request->location_id); 
		}
		}       
		if($request->price_range_id ){
		  $request->price_range_id = array_where($request->price_range_id, function ($value, $key) {
		   if($value > 0)
			return true;
		});	  
		  
		  if(count($request->price_range_id) > 0) 
			$enquiry->priceRanges()->sync($request->price_range_id);
		}

	  // }

		$enquiry->save();

	//Priority Price / Location
		if($request->sales_type == 2)       
		  $price_range_id =  $location_id = null;
		else{
		 $price_range_id = (count($request->price_range_id) > 0)?  $request->price_range_id[0] : null;
		 $location_id = (count($request->location_id) > 0)? $request->location_id[0] : null;       

	   }       

	   $sales =   Sales::where('sales_enquiry_id',$enquiry->id)  
	   ->where('work_flow_processes_code',$processFlow)->first();

	// Get Process Users
	   $general =  new General;
	   $processAssign = $general->roleUsersFromProcess($processFlow,$location_id,$price_range_id);

	   if(!empty($sales)) {

		 if(count($sales->salesUsers) > 0)
		   $sales->salesUsers()->detach();

	   }else{
		 $sales =   Sales::create([
		  'sales_enquiry_id' =>$enquiry->id,
		  'sales_type' => $enquiry->sales_type,
		  'work_flow_processes_code' => $processFlow,
		  'created_by' => \Auth::user()->id,
		  ]);
	   }

	   $users = array();

	   if($processAssign == false){

		$res =    $general->workFlowProcess($processFlow);
		$sales->salesUsers()->attach($res->default_role, ['user_id' => $res->default_user_id]);
		$sales->save();

		if(empty($res->default_user_id)){			 
		  $users_list = \App\User::role($res->default_role)->get()->pluck('id'); 			 
		  $users = $users_list->toArray();			  
		}else 
		$users[] = $res->default_user_id;



	  }else{
	   foreach($processAssign->assign as $val){
		 $user_id = $val->user_id;
		 if(empty($val->user_id))
		  $user_id = null;
		$sales->salesUsers()->attach($val->role_id, ['user_id' => $user_id]);
		$sales->save();


		if(empty($user_id)){			 
		  $users_list = \App\User::role($val->role_id)->get()->pluck('id'); 				 
		  $users_list = $users_list->toArray();	
		  $users_list = array_flatten($users_list);      

		  if(count($users) > 0){
			$users = array_merge($users,$users_list); 
		  }else			 		 
		  $users = $users_list;			  
		}else 
		$users[] = $user_id;     


	  }
} 


$users = array_flatten($users);      
$users_notify =  \App\User::whereIn('id',$users)->get(); 
/*Notification */
/*event(new UpdateEnquiry($enquiry,$users_notify));  */  

session()->flash('success', ' Enquiry Updated ');
return redirect($url);
      /*if($enquiry->sales_type == 1)
        return redirect()->route('tenantEnquiries');
      else
      return redirect()->route('landlordEnquiries');*/

    }

