{
    "info": {
        "name": "PLMS ARE Mobile API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Set baseUrl, username, password, deviceId; run Login first (it stores the token). ticketId / idId are the record ids for the {ticket} and {id} routes."
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://plms_backup.test/api/v1"
        },
        {
            "key": "username",
            "value": ""
        },
        {
            "key": "password",
            "value": ""
        },
        {
            "key": "deviceId",
            "value": "postman-device-01"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "ticketId",
            "value": ""
        },
        {
            "key": "idId",
            "value": ""
        },
        {
            "key": "itemId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth & device",
            "item": [
                {
                    "name": "Login and bind the device",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\",\n    \"device_uid\": \"{{deviceId}}\",\n    \"device_name\": \"Postman\",\n    \"platform\": \"android\",\n    \"app_version\": \"1.0.0\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const b = pm.response.json();",
                                    "if (b.token) { pm.collectionVariables.set(\"token\", b.token); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Revoke the current token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Device-Id",
                                "value": "{{deviceId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        }
                    }
                },
                {
                    "name": "Current user, buildings and device",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Device-Id",
                                "value": "{{deviceId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
