{
    "name": "alhabeeb/plms",
    "description": "PLMS - property & lease management.",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/cossou/jasperphp",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "artisaninweb/laravel-soap": "^0.3.0.10",
        "barryvdh/laravel-dompdf": "^3.1",
        "cossou/jasperphp": "^1.0",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "intervention/image": "^2.7",
        "kyslik/column-sortable": "^8.0",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.8",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^4.0",
        "mpdf/mpdf": "^8.2",
        "nwidart/laravel-modules": "^13.0",
        "setasign/fpdf": "^1.8",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.12",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/DynamicsFunctions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
