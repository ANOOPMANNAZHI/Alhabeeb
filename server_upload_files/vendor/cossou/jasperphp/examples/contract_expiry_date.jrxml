<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report8" pageWidth="1082" pageHeight="900" orientation="Landscape" columnWidth="1042" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8be69980-6eee-41d6-876e-601926a742e3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="75"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="918"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PLMS11112020"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="633"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="353"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="user" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="are_name" class="java.lang.String"/>
	<parameter name="Date2" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[select distinct b.building_name,e.employee_name,u.unit_no,ut.unit_types_name,t.tenant_name,tc.tenant_contract_no,coalesce(nullif(trim(t.tenant_contact_no),''),nullif(trim(t.gsm_no),''),'N/A') as gsm_no,tc.tenant_contract_muncipality_agr_no
,tc.tenant_contract_start_date,tc.tenant_contract_valid_to_date,tc.tenant_contract_last_paid_date,
tc.tenant_contract_last_paid_amt,
a.renteffectiveto,
tc.tenant_contract_rent as rent
from tenant_contracts tc 
left join buildings b on b.id=tc.building_id
left join units u on tc.unit_id=u.id
left join unit_types ut on ut.id = u.unit_type_id
left join tenant t on t.id=tc.tenant_id
left join receipts_generation rg on rg.tenant_contract_id=tc.id
left join (SELECT pb.building_id,employee_name from employees emp
		   left join users us on emp.id = us.user_type_id
		   left join are_buildings are on us.id=are.user_id
		   left join preferred_buildings pb on are.id=pb.are_building_id
		   where pb.assign_to is null)e on e.building_id = b.id
left join (SELECT tenant_contract_no,sum(rg.receipts_generation_amt) as receiptgeneration_amt
                from tenant_contracts tc 
                left join receipts_generation rg on rg.tenant_contract_id=tc.id 
                group by tenant_contract_no)c on c.tenant_contract_no=tc.tenant_contract_no
left join (SELECT tenant_contract_no,max(rg.receipts_generation_eff_to) as renteffectiveto
                  from tenant_contracts tc 
                  left join receipts_generation rg on rg.tenant_contract_id=tc.id 
                  group by tenant_contract_no)a on a.tenant_contract_no=tc.tenant_contract_no
left join termination ter on tc.id = ter.contract_id
where (tc.tenant_contract_valid_to_date between $P{Date1}  and $P{Date2})
AND (ter.termination_date IS NULL OR  ter.termination_date > tc.tenant_contract_valid_to_date)
order by u.unit_no]]>
	</queryString>
