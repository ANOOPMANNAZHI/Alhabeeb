	<parameter name="logo" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<parameter name="building_code" class="java.lang.String"/>
	<parameter name="building_name" class="java.lang.String"/>
	<parameter name="Date1" class="java.util.Date"/>
	<parameter name="Date2" class="java.util.Date"/>
	<parameter name="management_type" class="java.lang.String"/>
	<parameter name="pay_mode" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select c.paymentmethod,c.payment_method,c.BuildingName,c.DocNo,c.DocDate,c.fromdate,c.todate,c.DateEffFrom,c.DateEffTo,c.remark,c.rent,c.AgreementNo,c.tenantcode,c.tenantname,c.unitno,c.amount,c.unit_type from
(select rg.receipts_generation_payment_method as payment_method ,b.building_name as BuildingName,rg.receipts_generation_receipt_no as DocNo,
rg.receipts_generation_receipt_date as DocDate ,rg.receipts_generation_eff_from as DateEffFrom,
rg.receipts_generation_eff_to as DateEffTo,rg.receipts_generation_cheque_no as remark,tc.tenant_contract_rent as rent,
tc.tenant_contract_effective_date as fromdate,tc.tenant_contract_valid_to_date as todate,
tc.tenant_contract_no as AgreementNo,t.tenant_code as tenantcode,t.tenant_name as tenantname,u.unit_no as unitno,rg.receipts_generation_amt as amount,ut.unit_types_name as unit_type,
case when rg.receipts_generation_payment_method = 1 then 'Cheque' else 'Cash' end as paymentmethod
from receipts_generation rg  
left join tenant_contracts tc on rg.tenant_contract_id=tc.id
left join tenant t on tc.tenant_id=t.id
left join units u on tc.unit_id=u.id
left join unit_types ut on ut.id = u.unit_type_id
left join buildings b on u.building_id=b.id
left join management_types mt on b.management_id=mt.id
where ((rg.receipts_generation_status <> 2 and rg.receipts_generation_receipt_date between $P{Date1} and  $P{Date2}) and (rg.receipts_generation_type='0') and rg.deleted_at is null and ($P{pay_mode} = '' or CAST(rg.receipts_generation_payment_method AS text) = $P{pay_mode}) and b.building_name NOT LIKE '%-MERA' and ($P{management_type} = '' or mt.management_types_name = $P{management_type}))
)c
order by  c.unitno]]>
	</queryString>
